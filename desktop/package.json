{
  "name": "azdocs-desktop",
  "private": true,
  "version": "0.1.1",
  "license": "MIT",
  "repository": "https://github.com/russmckendrick/azdocs",
  "type": "module",
  "scripts": {
    "assets": "node scripts/sync-assets.mjs",
    "licenses": "node scripts/frontend-licenses.mjs",
    "licenses:check": "node scripts/frontend-licenses.mjs --check",
    "screenshots": "node scripts/screenshots.mjs",
    "dev": "pnpm run assets && vite --host 127.0.0.1 --port 1420",
    "build": "pnpm run assets && tsc && vite build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "icons": "node scripts/sync-icons.mjs",
    "icons:generate": "tauri icon ../docs/marks/assets/azdocs-app-icon-light.svg",
    "test": "vitest run",
    "preview": "vite preview --host 127.0.0.1 --port 1420",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "cytoscape": "^3.34.1",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tauri-apps/cli": "^2.8.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.4.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "jsdom": "^30.1.0",
    "prettier": "^3.9.6",
    "puppeteer-core": "^25.11.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^7.1.3",
    "vitest": "^4.1.11"
  }
}
