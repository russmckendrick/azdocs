{
  "name": "azdocs-desktop",
  "private": true,
  "version": "0.3.0",
  "license": "MIT",
  "repository": "https://github.com/russmckendrick/azdocs",
  "packageManager": "pnpm@12.4.2",
  "type": "module",
  "scripts": {
    "assets": "node scripts/sync-assets.mjs",
    "licenses": "node scripts/frontend-licenses.mjs",
    "licenses:check": "node scripts/frontend-licenses.mjs --check",
    "screenshots": "node scripts/screenshots.mjs",
    "dev": "pnpm run assets && vite --host 127.0.0.1 --port 1420",
    "build": "pnpm run assets && tsc && vite build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "icons": "node scripts/sync-icons.mjs",
    "icons:generate": "tauri icon ../docs/marks/assets/azdocs-app-icon-light.svg",
    "test": "vitest run",
    "preview": "vite preview --host 127.0.0.1 --port 1420",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "cytoscape": "^3.34.3",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.11.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^30.1.0",
    "prettier": "^3.9.8",
    "puppeteer-core": "^25.11.0",
    "topojson-client": "^3.1.0",
    "topojson-simplify": "^3.0.3",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "world-atlas": "^2.0.2"
  }
}
