---
source: tests/report_golden_test.rs
expression: "std::fs::read_to_string(&out).unwrap()"
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Azure Estate Report — fixture-tenant</title>
<style>
/* Every colour and face below comes from the resolved theme
   (src/report/theme.rs), so the HTML matches the PDF and DOCX. */
:root { --bg:#faf8f4; --fg:#1c2430;
        --muted:#5a6470; --border:#d8d2c6;
        --primary:#1c2430; --accent:#0078d4;
        --accent-dark:#14181d;
        --tint:#f3efe7; --zebra:#f3efe7;
        --on-accent:#faf8f4;
        --high:#a83a22; --high-fill:#f5e4df;
        --medium:#8a6d00; --medium-fill:#f3edd1;
        --low:#5a6470; --low-fill:#f3efe7;
        --info:#0078d4; --info-fill:#e6f2fb;
        --radius:3.0px; }
@media (prefers-color-scheme: dark) {
  :root { --bg:#14181d; --fg:#e9e4da; --muted:#9a958a; --border:#3a4048; --zebra:#10141a;
          --tint:#10141a; --accent:#4da3e8; }
}
/* The vendored PDF face first; an uninstalled IBM Plex falls through to the
   platform stack rather than forcing a web-font download. */
body { font: 15px/1.35 "IBM Plex Sans", -apple-system, "Segoe UI", Roboto, sans-serif;
       background: var(--bg); color: var(--fg); max-width: 1100px; margin: 0 auto; padding: 2rem 1rem; }
h1,h2,h3 { font-family: "IBM Plex Serif", Georgia, serif; line-height: 1.2; }
h2 { border-bottom: 1px solid var(--border); padding-bottom: .3rem; margin-top: 2.5rem; }
table { border-collapse: collapse; width: 100%; margin: 1rem 0; font-size: 14px; }
th, td { text-align: left; padding: .35rem .6rem; border-bottom: 1px solid var(--border); vertical-align: top; }
th { position: sticky; top: 0;
     background: transparent;
     color: var(--fg); }
code { font-family: "IBM Plex Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
       background: var(--tint); padding: .1em .3em; border-radius: 3px; font-size: 90%; word-break: break-all; }
.badge { display: inline-block; padding: .05em .55em; border-radius: 999px; font-size: 12px; font-weight: 600; text-transform: uppercase; }
.badge.high { background: var(--high-fill); color: var(--high); }
.badge.medium { background: var(--medium-fill); color: var(--medium); }
.badge.low { background: var(--low-fill); color: var(--low); }
.badge.info { background: var(--info-fill); color: var(--info); }
.stats { display: flex; gap: 1rem; flex-wrap: wrap; margin: 1.5rem 0; }
.stat {
        border-radius: var(--radius); padding: .8rem 1.2rem; min-width: 8rem; }
.stat b { display: block; font-family: "IBM Plex Serif", Georgia, serif;
          font-size: 1.6rem; color: var(--accent-dark); }
.stat span { color: var(--muted); font-size: 13px; }
.meta { color: var(--muted); font-size: 13px; }
input.filter { width: 100%; max-width: 24rem; padding: .4rem .6rem; margin: .3rem 0;
       border: 1px solid var(--border); border-radius: 6px; background: var(--bg); color: var(--fg); }
details { margin: 1rem 0; } summary { cursor: pointer; font-weight: 600; }
</style>
</head>
<body>
<h1>Azure Estate Report</h1>
<p class="meta">Snapshot <code>[snapshot-id]</code> · collected [timestamp] · tenant <code>fixture-tenant</code> · status complete · golden fixture</p>

<div class="stats">
  <div class="stat"><b>2</b><span>subscriptions</span></div>
  <div class="stat"><b>3</b><span>resource groups</span></div>
  <div class="stat"><b>18</b><span>resources</span></div>
  <div class="stat"><b>13</b><span>findings</span></div>
  <div class="stat"><b>50%</b><span>tag coverage</span></div>
</div>

<h2>Findings</h2>
