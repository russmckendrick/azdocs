<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Azure Estate Report — fixture-tenant</title>
<style>
:root { --bg:#fff; --fg:#1a1a2e; --muted:#666; --border:#ddd; --accent:#0078d4;
        --high:#d13438; --medium:#ff8c00; --low:#c9a900; --info:#0078d4; }
@media (prefers-color-scheme: dark) {
  :root { --bg:#16161d; --fg:#e8e8ef; --muted:#9a9aa5; --border:#3a3a45; }
}
body { font: 15px/1.5 -apple-system, "Segoe UI", Roboto, sans-serif;
       background: var(--bg); color: var(--fg); max-width: 1100px; margin: 0 auto; padding: 2rem 1rem; }
h1,h2,h3 { line-height: 1.2; } h2 { border-bottom: 1px solid var(--border); padding-bottom: .3rem; margin-top: 2.5rem; }
table { border-collapse: collapse; width: 100%; margin: 1rem 0; font-size: 14px; }
th, td { text-align: left; padding: .35rem .6rem; border-bottom: 1px solid var(--border); vertical-align: top; }
th { position: sticky; top: 0; background: var(--bg); }
code { background: rgba(127,127,127,.12); padding: .1em .3em; border-radius: 3px; font-size: 90%; word-break: break-all; }
.badge { display: inline-block; padding: .05em .55em; border-radius: 999px; color: #fff; font-size: 12px; font-weight: 600; text-transform: uppercase; }
.badge.high { background: var(--high); } .badge.medium { background: var(--medium); }
.badge.low { background: var(--low); } .badge.info { background: var(--info); }
.stats { display: flex; gap: 1rem; flex-wrap: wrap; margin: 1.5rem 0; }
.stat { border: 1px solid var(--border); border-radius: 8px; padding: .8rem 1.2rem; min-width: 8rem; }
.stat b { display: block; font-size: 1.6rem; } .stat span { color: var(--muted); font-size: 13px; }
.meta { color: var(--muted); font-size: 13px; }
input.filter { width: 100%; max-width: 24rem; padding: .4rem .6rem; margin: .3rem 0;
       border: 1px solid var(--border); border-radius: 6px; background: var(--bg); color: var(--fg); }
details { margin: 1rem 0; } summary { cursor: pointer; font-weight: 600; }
</style>
</head>
<body>
<h1>Azure Estate Report</h1>
<p class="meta">Snapshot <code>[snapshot-id]</code> · collected [timestamp] · tenant <code>fixture-tenant</code> · status complete · golden fixture</p>

<div class="stats">
  <div class="stat"><b>2</b><span>subscriptions</span></div>
  <div class="stat"><b>3</b><span>resource groups</span></div>
  <div class="stat"><b>15</b><span>resources</span></div>
  <div class="stat"><b>11</b><span>findings</span></div>
  <div class="stat"><b>53%</b><span>tag coverage</span></div>
</div>

