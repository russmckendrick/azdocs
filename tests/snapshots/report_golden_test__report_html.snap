<td>vm-app-01-pip is missing tags: env</td><td>governance</td><td><code>missing_required_tags</code></td>
<td><code>/subscriptions/sub-prod/resourcegroups/rg-app/providers/microsoft.network/publicipaddresses/vm-app-01-pip</code></td></tr>
<tr><td><span class="badge low">low</span></td>
<td>web-dev is missing tags: env</td><td>governance</td><td><code>missing_required_tags</code></td>
<td><code>/subscriptions/sub-dev/resourcegroups/rg-dev/providers/microsoft.web/sites/web-dev</code></td></tr>
