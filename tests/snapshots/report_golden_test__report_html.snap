<span class="badge high">2 high</span>
<span class="badge medium">1 medium</span>
<span class="badge low">9 low</span>
<span class="badge info">1 info</span>
</p>

<input class="filter" type="search" placeholder="Filter findings..." oninput="filterTable(this, 'findings-table')">
<table id="findings-table">
<thead><tr><th>Severity</th><th>Title</th><th>Category</th><th>Check</th><th>Resource</th></tr></thead>
