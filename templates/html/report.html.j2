<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ branding.title }} — {{ tenant_id }}</title>
<style>
/* Every colour and face below comes from the resolved theme
   (src/report/theme.rs), so the HTML matches the PDF and DOCX. */
:root { --bg:{{ branding.tokens.palette.surface }}; --fg:{{ branding.tokens.palette.ink }};
        --muted:{{ branding.tokens.palette.muted }}; --border:{{ branding.tokens.palette.rule }};
        --accent:{{ branding.tokens.palette.primary }}; --accent-dark:{{ branding.tokens.palette.primary_dark }};
        --tint:{{ branding.tokens.palette.primary_tint }}; --zebra:{{ branding.tokens.palette.zebra }};
        --on-accent:{{ branding.tokens.palette.on_primary }};
        --high:{{ branding.tokens.palette.severity.high.text }}; --high-fill:{{ branding.tokens.palette.severity.high.fill }};
        --medium:{{ branding.tokens.palette.severity.medium.text }}; --medium-fill:{{ branding.tokens.palette.severity.medium.fill }};
        --low:{{ branding.tokens.palette.severity.low.text }}; --low-fill:{{ branding.tokens.palette.severity.low.fill }};
        --info:{{ branding.tokens.palette.severity.info.text }}; --info-fill:{{ branding.tokens.palette.severity.info.fill }};
        --radius:{{ branding.tokens.layout.radius_pt|round(1) }}px; }
@media (prefers-color-scheme: dark) {
  :root { --bg:#16161d; --fg:#e8e8ef; --muted:#9a9aa5; --border:#3a3a45; --zebra:#1c1c25;
          --tint:#1e2430; --accent:{{ branding.accent_color }}; }
}
/* The vendored PDF face first; an uninstalled IBM Plex falls through to the
   platform stack rather than forcing a web-font download. */
body { font: 15px/{{ branding.tokens.typography.line_height|round(2) }} "{{ branding.tokens.typography.sans }}", -apple-system, "Segoe UI", Roboto, sans-serif;
       background: var(--bg); color: var(--fg); max-width: 1100px; margin: 0 auto; padding: 2rem 1rem; }
h1,h2,h3 { line-height: 1.2; } h2 { border-bottom: 1px solid var(--border); padding-bottom: .3rem; margin-top: 2.5rem; }
table { border-collapse: collapse; width: 100%; margin: 1rem 0; font-size: 14px; }
th, td { text-align: left; padding: .35rem .6rem; border-bottom: 1px solid var(--border); vertical-align: top; }
th { position: sticky; top: 0; background: {% if branding.tokens.layout.table == "solid-header" %}var(--accent); color: var(--on-accent){% else %}var(--tint){% endif %}; }
{%- if branding.tokens.layout.zebra_rows %}
tbody tr:nth-child(even) { background: var(--zebra); }
{%- endif %}
code { background: rgba(127,127,127,.12); padding: .1em .3em; border-radius: 3px; font-size: 90%; word-break: break-all; }
.badge { display: inline-block; padding: .05em .55em; border-radius: 999px; font-size: 12px; font-weight: 600; text-transform: uppercase; }
.badge.high { background: var(--high-fill); color: var(--high); }
.badge.medium { background: var(--medium-fill); color: var(--medium); }
.badge.low { background: var(--low-fill); color: var(--low); }
.badge.info { background: var(--info-fill); color: var(--info); }
.stats { display: flex; gap: 1rem; flex-wrap: wrap; margin: 1.5rem 0; }
.stat { {% if branding.tokens.layout.stat == "card" %}background: var(--tint); border-top: 2px solid var(--accent);
        {%- elif branding.tokens.layout.stat == "outline" %}border: 1px solid var(--border);{% endif %}
        border-radius: var(--radius); padding: .8rem 1.2rem; min-width: 8rem; }
.stat b { display: block; font-size: 1.6rem; color: var(--accent-dark); } .stat span { color: var(--muted); font-size: 13px; }
.meta { color: var(--muted); font-size: 13px; }
input.filter { width: 100%; max-width: 24rem; padding: .4rem .6rem; margin: .3rem 0;
       border: 1px solid var(--border); border-radius: 6px; background: var(--bg); color: var(--fg); }
details { margin: 1rem 0; } summary { cursor: pointer; font-weight: 600; }
</style>
</head>
<body>
{%- if branding.logo %}
<p><img src="{{ branding.logo.data_uri }}" alt="logo" style="max-height:64px"></p>
{%- endif %}
<h1>{{ branding.title }}</h1>
{%- if branding.subtitle or branding.company %}
<p class="meta">{% if branding.subtitle %}{{ branding.subtitle }}{% endif %}{% if branding.subtitle and branding.company %} · {% endif %}{{ branding.company }}</p>
{%- endif %}
<p class="meta">Snapshot <code>{{ snapshot_id }}</code> · collected {{ created_at }} · tenant <code>{{ tenant_id }}</code> · status {{ status }}{% if notes %} · {{ notes }}{% endif %}</p>

<div class="stats">
  <div class="stat"><b>{{ totals.subscriptions }}</b><span>subscriptions</span></div>
  <div class="stat"><b>{{ totals.resource_groups }}</b><span>resource groups</span></div>
  <div class="stat"><b>{{ totals.resources }}</b><span>resources</span></div>
  <div class="stat"><b>{{ totals.findings }}</b><span>findings</span></div>
  <div class="stat"><b>{{ tag_coverage.percent }}%</b><span>tag coverage</span></div>
</div>

<h2>Findings</h2>
<p>
<span class="badge high">{{ severity_counts.high }} high</span>
<span class="badge medium">{{ severity_counts.medium }} medium</span>
<span class="badge low">{{ severity_counts.low }} low</span>
<span class="badge info">{{ severity_counts.info }} info</span>
</p>
{% if findings %}
<input class="filter" type="search" placeholder="Filter findings..." oninput="filterTable(this, 'findings-table')">
<table id="findings-table">
<thead><tr><th>Severity</th><th>Title</th><th>Category</th><th>Check</th><th>Resource</th></tr></thead>
<tbody>
{%- for f in findings %}
<tr><td><span class="badge {{ f.severity }}">{{ f.severity }}</span></td>
<td>{{ f.title }}</td><td>{{ f.category }}</td><td><code>{{ f.query_name }}</code></td>
<td>{% if f.resource_id %}<code>{{ f.resource_id }}</code>{% endif %}</td></tr>
{%- endfor %}
</tbody>
</table>
{% else %}<p>No findings. 🎉</p>{% endif %}

<h2>Governance</h2>
<div class="stats">
  <div class="stat"><b>{{ tag_coverage.percent }}%</b><span>tag coverage</span></div>
  <div class="stat"><b>{{ governance.distinct_keys }}</b><span>distinct keys</span></div>
  <div class="stat"><b>{{ governance.non_compliant }}</b><span>non-compliant</span></div>
</div>
{% if governance.top_keys %}
<table>
<thead><tr><th>Tag key</th><th>Resources</th><th>Share of {{ tag_coverage.tagged }} tagged</th></tr></thead>
<tbody>
{%- for key in governance.top_keys %}
<tr><td><code>{{ key.key }}</code></td><td>{{ key.count }}</td><td>{{ key.percent }}%</td></tr>
{%- endfor %}
</tbody>
</table>
{% else %}<p>No tags are stored in this snapshot.</p>{% endif %}
{%- if governance.subscriptions %}
<table>
<thead><tr><th>Subscription</th><th>Tag coverage</th><th>Status</th></tr></thead>
<tbody>
{%- for sub in governance.subscriptions %}
<tr><td>{{ sub.display_name }}</td><td>{{ sub.percent }}%</td>
<td><span class="badge {{ "info" if sub.healthy else "medium" }}">{{ "healthy" if sub.healthy else "below threshold" }}</span></td></tr>
{%- endfor %}
</tbody>
</table>
{%- endif %}
{% if governance.worst_groups %}
<p>{{ governance.non_compliant }} resources are missing at least one required tag, recorded by the <code>missing_required_tags</code> audit.</p>
<table>
<thead><tr><th>Resource group</th><th>Subscription</th><th>Resources</th><th>Non-compliant</th><th>Missed tags</th></tr></thead>
<tbody>
{%- for group in governance.worst_groups %}
<tr><td>{{ group.name }}</td><td>{{ group.subscription_name }}</td><td>{{ group.resources }}</td>
<td>{% if group.flagged %}<span class="badge high">{{ group.non_compliant }}</span>{% else %}{{ group.non_compliant }}{% endif %}</td>
<td>{% for tag in group.missed_tags %}<code>{{ tag }}</code>{% if not loop.last %} {% endif %}{% endfor %}</td></tr>
{%- endfor %}
</tbody>
</table>
{%- endif %}

<h2>Resources by type</h2>
<table>
<thead><tr><th>Type</th><th>Azure type</th><th>Count</th></tr></thead>
<tbody>
{%- for tc in type_counts %}
<tr><td>{{ tc.display }}</td><td><code>{{ tc.azure_type }}</code></td><td>{{ tc.count }}</td></tr>
{%- endfor %}
</tbody>
</table>

{% for category in categories %}
<h2>{{ category.name | title }}</h2>
{% for query in category.queries %}
<details {% if loop.first %}open{% endif %}>
<summary>{{ query.name }} ({{ query.rows | length }})</summary>
<p class="meta">{{ query.description }}</p>
<table>
<thead><tr>{% for c in query.columns %}<th>{{ c }}</th>{% endfor %}</tr></thead>
<tbody>
{%- for row in query.rows %}
<tr>{% for c in query.columns %}<td>{{ row | html_cell(c) }}</td>{% endfor %}</tr>
{%- endfor %}
</tbody>
</table>
</details>
{% endfor %}
{% endfor %}

<h2>Subscriptions</h2>
{% for sub in subscriptions %}
<h3>{{ sub.display_name }} <span class="meta">({{ sub.subscription_id }} · {{ sub.resource_count }} resources)</span></h3>
{% for rg in sub.resource_groups %}
<details>
<summary>{{ rg.name }}{% if rg.location %} — {{ rg.location }}{% endif %} ({{ rg.resources | length }})</summary>
<table>
<thead><tr><th>Name</th><th>Type</th><th>Location</th><th>Tags</th></tr></thead>
<tbody>
{%- for r in rg.resources %}
<tr><td>{{ r.name }}</td><td>{{ r.display_type }}</td><td>{{ r.location or "" }}</td><td>{% if r.tags %}<code>{{ r.tags }}</code>{% endif %}</td></tr>
{%- endfor %}
</tbody>
</table>
</details>
{% endfor %}
{% endfor %}

<p class="meta">{{ branding.footer }}</p>
<script>
function filterTable(input, id) {
  const needle = input.value.toLowerCase();
  for (const row of document.getElementById(id).tBodies[0].rows) {
    row.style.display = row.textContent.toLowerCase().includes(needle) ? "" : "none";
  }
}
</script>
</body>
</html>
